# Required. API_KEY is accepted as an alias. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key

# Optional. Empty FILE_SEARCH_STORE_NAME = find or create the store with the display name below.
FILE_SEARCH_STORE_NAME=
FILE_SEARCH_STORE_DISPLAY_NAME=optibot-help-center
HELP_CENTER_URL=https://support.optisigns.com
HELP_CENTER_LOCALE=en-us
# 0 = all published articles
MAX_ARTICLES=0
OUTPUT_DIR=articles
# White-space chunking: tokens are words
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=100
# Keep low on the free tier to stay under the rate limit
UPLOAD_WORKERS=4
# 1 = allow one run to delete more than 20% of stored articles
ALLOW_MASS_DELETE=
# Only used by ask.py
GEMINI_MODEL=gemini-3.5-flash
